{
    "name": "AS-ZARA-MINI",
    "version": "1.0.0",
    "description": "WhatsApp MD-Style Multi-Command Bot with Baileys",
    "main": "index.js",
    "type": "commonjs",
    "scripts": {
        "start": "node index.js",
        "dev": "nodemon --signal SIGTERM index.js",
        "check": "node --check index.js && node --check handler.js && node --check utils/sessionManager.js",
        "test:smoke": "node test_handler_import.js && node smoke_tests.js && node test_session_manager.js",
        "install:no-puppeteer": "PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm ci"
    },
    "keywords": [
        "whatsapp bot",
        "Dex Mini Bot",
        "bot",
        "baileys",
        "md"
    ],
    "author": "Dex Shyam Chaudhari",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@bochilteam/scraper": "^5.0.1",
        "@bochilteam/scraper-tiktok": "^5.0.0",
        "@bochilteam/scraper-facebook": "^5.0.0",
        "@vitalets/google-translate-api": "^9.2.1",
        "@whiskeysockets/baileys": "7.0.0-rc14",
        "axios": "^1.7.2",
        "canvas": "^3.2.1",
        "cheerio": "^1.0.0-rc.12",
        "ffmpeg-static": "^5.3.0",
        "file-type": "^16.5.4",
        "fluent-ffmpeg": "^2.1.3",
        "form-data": "^4.0.0",
        "gifted-btns": "1.0.2",
        "jimp": "^1.6.0",
        "lottie-node": "^2.0.0",
        "lottie-web": "^5.13.0",
        "moment-timezone": "^0.5.45",
        "mumaker": "^2.0.0",
        "node-fetch": "^2.7.0",
        "node-cache": "^5.1.2",
        "node-webpmux": "^3.1.7",
        "pino": "^9.0.0",
        "qrcode": "^1.5.3",
        "qrcode-terminal": "^0.12.0",
        "ruhend-scraper": "^9.0.8",
        "simple-git": "^3.27.0",
        "sharp": "^0.33.4",
        "yt-search": "^2.13.1",
        "ytdl-core": "^4.11.5"
    },
    "devDependencies": {
        "nodemon": "^3.1.0"
    }
}
